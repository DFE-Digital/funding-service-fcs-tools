<UserControl x:Class="BuildQuery.BurndownChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BuildQuery"
             xmlns:tfsData="clr-namespace:BuildQuery.TfsData.Models;assembly=BuildQuery.TfsData"
             xmlns:charting="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <local:DataPointNullConverter x:Key="dataPointNullConverter"/>
        <local:IdealDataPointNullConverter x:Key="idealDataPointNullConverter"/>
    </UserControl.Resources>
    <Grid>
        <charting:Chart  Name="lineChart" Title="{Binding Team}" DataContext="{Binding}" VerticalAlignment="Stretch"
		  >
            <charting:LineSeries  
                                  Title="Hours Remaining" 
                                  DependentValuePath="RemainingWorkHours" 
		                          IndependentValuePath="Index"
                                  ItemsSource="{Binding DataPoints,Converter={StaticResource dataPointNullConverter}}" 
	                              IsSelectionEnabled="False"
                                  DependentRangeAxis="{Binding ElementName=HoursAxis}" > 
                
            </charting:LineSeries>
            <charting:LineSeries  
                                  Title="Ideal Hours" 
                                  DependentValuePath="IdealTrendHours" 
		                          IndependentValuePath="Index"
                                  ItemsSource="{Binding DataPoints,Converter={StaticResource idealDataPointNullConverter}}" 
	                              IsSelectionEnabled="False"
                                  DependentRangeAxis="{Binding ElementName=HoursAxis}" >
                
            </charting:LineSeries>
            <charting:LineSeries  
                        Title="Points Remaining"
                                  DependentValuePath="RemainingWorkPoints"
                                  IndependentValuePath="Index"
                                  ItemsSource="{Binding DataPoints,Converter={StaticResource dataPointNullConverter}}" 
	                              IsSelectionEnabled="False"
                                  DependentRangeAxis="{Binding ElementName=PointsAxis}"
                                  >
                
            </charting:LineSeries>
            <charting:LineSeries  
                        Title="Ideal Points"
                                  DependentValuePath="IdealTrendPoints"
                                  IndependentValuePath="Index"
                                  ItemsSource="{Binding DataPoints,Converter={StaticResource idealDataPointNullConverter}}" 
	                              IsSelectionEnabled="False"
                                  DependentRangeAxis="{Binding ElementName=PointsAxis}"
                                  >

            </charting:LineSeries>
            <charting:Chart.Axes>
                <charting:LinearAxis Orientation="X" Minimum="0" Maximum="8" Title="Days"/>
                <charting:LinearAxis x:Name="HoursAxis" Location="Left" Orientation="Y" Minimum="0" Title="Hours" />
                <charting:LinearAxis x:Name="PointsAxis" Location="Right" Orientation="Y" Minimum="0" Title="Points" />

                <!--<charting:LinearAxis Orientation="Y" Minimum="0" />-->
            </charting:Chart.Axes>
        </charting:Chart>
    </Grid>
</UserControl>
