<UserControl x:Class="WpfControls.Audit.SearchControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfControls.Audit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Margin="5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Content="Start Date:" HorizontalAlignment="Stretch" BorderThickness="5" VerticalAlignment="Top"></Label>
        <DatePicker HorizontalAlignment="Stretch" Grid.Column="1" Height="40" BorderThickness="1" VerticalAlignment="Top" SelectedDate="{Binding StartDate}"></DatePicker>
        <Label Content="End Date:" HorizontalAlignment="Stretch" Grid.Column="2" BorderThickness="5" VerticalAlignment="Top"></Label>
        <DatePicker HorizontalAlignment="Stretch" Grid.Column="3" Height="40" BorderThickness="1" VerticalAlignment="Top" SelectedDate="{Binding EndDate}"></DatePicker>
        <Label Grid.Row="1" Content="Full Message Type:" HorizontalAlignment="Stretch" BorderThickness="5" VerticalAlignment="Top"></Label>
        <TextBox Grid.Row="1" HorizontalAlignment="Stretch" Grid.Column="1" Height="40" BorderThickness="1" VerticalAlignment="Top" Text="{Binding MessageType}"></TextBox>
        <Label Grid.Row="1" Grid.Column="2" Content="Business Key" HorizontalAlignment="Stretch" BorderThickness="5" VerticalAlignment="Top"></Label>
        <TextBox Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Height="40" BorderThickness="1" VerticalAlignment="Top" Text="{Binding BusinessKey}"></TextBox>

        <Button Grid.Column="3" Grid.Row="1" Height="40" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="100" Command="{Binding SearchCommand}">Search</Button>
        
    </Grid>
</UserControl>
